<!--
  Plugin configuration for KeetScript (.keet) support in CLion / IntelliJ IDEA
-->
<idea-plugin>
    <id>com.keet.intellij</id>
    <name>KeetScript Support</name>
    <vendor email="support@keet.dev" url="https://github.com/paweljjar/keet">Keet Framework</vendor>

    <description><![CDATA[
    Dedicated IDE support for <b>KeetScript</b> (<code>.keet</code>) Single-File Components in CLion and IntelliJ IDEA.<br/>
    Features include:
    <ul>
        <li>Syntax highlighting for <code>&lt;script&gt;</code>, <code>&lt;template&gt;</code>, and <code>&lt;style&gt;</code>.</li>
        <li>Code completion for two-way bindings (<code>bind:value</code>, <code>bind:checked</code>) and event handlers.</li>
        <li>Live error diagnostics and linting via the companion <code>keety</code> compiler.</li>
    </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.clion</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File Type Registration for .keet -->
        <fileType
                name="Keet"
                implementationClass="com.keet.plugin.KeetFileType"
                fieldName="INSTANCE"
                language="Keet"
                extensions="keet"/>

        <!-- Autocompletion Contributor -->
        <completion.contributor
                language="Keet"
                implementationClass="com.keet.plugin.KeetCompletionContributor"/>

        <!-- Real-Time Error Diagnostics via keety linting -->
        <externalAnnotator
                language="Keet"
                implementationClass="com.keet.plugin.KeetExternalAnnotator"/>
    </extensions>
</idea-plugin>
