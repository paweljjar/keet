{
  "Server Block": {
    "prefix": "server",
    "body": [
      "<server>",
      "\tdatabase ${1:db}(\"${2:app.db}\") {",
      "\t\ttable ${3:items} {",
      "\t\t\tid: int primary_key auto_increment,",
      "\t\t\t${4:title}: string",
      "\t\t};",
      "\t};",
      "",
      "\tbackend ${5:api}(port: ${6:8080}, threads: ${7:4}) {",
      "\t\tget \"/api/${3:items}\" => (req) {",
      "\t\t\treturn ${1:db}.table(\"${3:items}\").find();",
      "\t\t};",
      "\t};",
      "",
      "\tfrontend ${8:web}(port: ${9:3000}, api: \"http://localhost:${6:8080}\", title: \"${10:Keet App}\");",
      "</server>"
    ],
    "description": "Full-stack server infrastructure block (Database, Backend API, Frontend Server)"
  },
  "Database Declaration": {
    "prefix": "database",
    "body": [
      "database ${1:db}(\"${2:app.db}\") {",
      "\ttable ${3:items} {",
      "\t\tid: int primary_key auto_increment,",
      "\t\t${4:name}: string",
      "\t};",
      "};"
    ],
    "description": "Embedded SQLite database declaration with table schema"
  },
  "Table Declaration": {
    "prefix": "table",
    "body": [
      "table ${1:items} {",
      "\tid: int primary_key auto_increment,",
      "\t${2:name}: string",
      "};"
    ],
    "description": "Database table schema definition"
  },
  "Backend Server": {
    "prefix": "backend",
    "body": [
      "backend ${1:api}(port: ${2:8080}, threads: ${3:4}) {",
      "\tget \"${4:/api/items}\" => (req) {",
      "\t\treturn ${5:db}.table(\"${6:items}\").find();",
      "\t};",
      "};"
    ],
    "description": "Backend HTTP microservice declaration"
  },
  "Frontend Server": {
    "prefix": "frontend",
    "body": [
      "frontend ${1:web}(port: ${2:3000}, api: \"${3:http://localhost:8080}\", title: \"${4:Keet App}\");"
    ],
    "description": "Frontend web server declaration mounting reactive SFC"
  },
  "HTTP GET Route": {
    "prefix": "get",
    "body": [
      "get \"${1:/api/path}\" => (${2:req}) {",
      "\t${0:return db.table(\"items\").find();}",
      "};"
    ],
    "description": "HTTP GET route definition"
  },
  "HTTP POST Route": {
    "prefix": "post",
    "body": [
      "post \"${1:/api/path}\" => (${2:req}) {",
      "\t${0:return db.table(\"items\").insert(req.json().asObject());}",
      "};"
    ],
    "description": "HTTP POST route definition"
  },
  "Script Block": {
    "prefix": "script",
    "body": [
      "<script>",
      "\tstate ${1:count}: int = 0;",
      "</script>"
    ],
    "description": "KeetScript component logic and state block"
  },
  "Template Block": {
    "prefix": "template",
    "body": [
      "<template>",
      "\t<div>",
      "\t\t${0}",
      "\t</div>",
      "</template>"
    ],
    "description": "KeetScript declarative HTML virtual DOM template"
  },
  "Style Block": {
    "prefix": "style",
    "body": [
      "<style>",
      "\t${0}",
      "</style>"
    ],
    "description": "KeetScript scoped CSS style block"
  },
  "State Declaration": {
    "prefix": "state",
    "body": [
      "state ${1:name}: ${2:int} = ${3:0};"
    ],
    "description": "Reactive component state variable"
  },
  "Let Declaration": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:string} = ${3:\"\"};"
    ],
    "description": "Component prop or constant"
  },
  "Def Function": {
    "prefix": "def",
    "body": [
      "def ${1:handleEvent}(${2:params}) -> ${3:void} {",
      "\t${0}",
      "}"
    ],
    "description": "KeetScript method / helper function"
  },
  "Native C++ Import": {
    "prefix": "import cpp",
    "body": [
      "import cpp from \"${1:Header.h}\" as ${2:Module};"
    ],
    "description": "Native C++ bridge import"
  },
  "Bind Value Directive": {
    "prefix": "bind:value",
    "body": [
      "bind:value={${1:stateVar}}"
    ],
    "description": "Two-way text/number input binding"
  },
  "Bind Checked Directive": {
    "prefix": "bind:checked",
    "body": [
      "bind:checked={${1:boolVar}}"
    ],
    "description": "Two-way checkbox input binding"
  },
  "Inline Event Handler": {
    "prefix": "onClick",
    "body": [
      "onClick={() => ${1:count += 1}}"
    ],
    "description": "Inline event callback mutation"
  },
  "Full-Stack SFC Template": {
    "prefix": "keetapp",
    "body": [
      "<server>",
      "\tdatabase db(\"${1:app.db}\") {",
      "\t\ttable ${2:items} {",
      "\t\t\tid: int primary_key auto_increment,",
      "\t\t\ttitle: string",
      "\t\t};",
      "\t};",
      "",
      "\tbackend api(port: 8081, threads: 4) {",
      "\t\tget \"/api/${2:items}\" => (req) {",
      "\t\t\treturn db.table(\"${2:items}\").find();",
      "\t\t};",
      "\t};",
      "",
      "\tfrontend web(port: 8080, api: \"http://localhost:8081\", title: \"${3:My App}\");",
      "</server>",
      "",
      "<script>",
      "\tstate count: int = 0;",
      "</script>",
      "",
      "<template>",
      "\t<div class=\"container\">",
      "\t\t<h1>${3:My App}</h1>",
      "\t\t<button onClick={() => count += 1}>Clicks: {count}</button>",
      "\t</div>",
      "</template>",
      "",
      "<style>",
      "\t.container { padding: 2rem; }",
      "</style>"
    ],
    "description": "Complete Full-Stack KeetScript Single-File Application template"
  }
}
