{
  "name": "vscode-keetscript",
  "displayName": "KeetScript Support",
  "description": "Rich language support, syntax highlighting, autocompletion snippets, and live compiler diagnostics for KeetScript (.keet) Single-File Components and Full-Stack apps.",
  "version": "1.0.0",
  "publisher": "keet",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "keet",
    "keetscript",
    "sfc",
    "cpp",
    "fullstack",
    "ui"
  ],
  "activationEvents": [
    "onLanguage:keet"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "keet",
        "aliases": [
          "KeetScript",
          "keet"
        ],
        "extensions": [
          ".keet"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "keet",
        "scopeName": "source.keet",
        "path": "./syntaxes/keet.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "keet",
        "path": "./snippets/keet.json"
      }
    ],
    "commands": [
      {
        "command": "keetscript.compileComponent",
        "title": "Keet: Compile Component to C++",
        "category": "KeetScript"
      },
      {
        "command": "keetscript.compileApplication",
        "title": "Keet: Compile Full-Stack Application (--app)",
        "category": "KeetScript"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == keet",
          "command": "keetscript.compileComponent",
          "group": "keet@1"
        },
        {
          "when": "editorLangId == keet",
          "command": "keetscript.compileApplication",
          "group": "keet@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "KeetScript Configuration",
      "properties": {
        "keetscript.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the keety compiler executable. If omitted, auto-detects in workspace build directories (e.g. cmake-build-debug/keety)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
