{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KeetScript",
  "scopeName": "source.keet",
  "fileTypes": ["keet"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#script-section" },
    { "include": "#style-section" },
    { "include": "#template-section" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.html.keet",
          "begin": "<!--",
          "end": "-->"
        },
        {
          "name": "comment.line.double-slash.keet",
          "match": "//.*$"
        },
        {
          "name": "comment.block.keet",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "script-section": {
      "begin": "(<)(script)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(script)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.script.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#script-keywords" },
        { "include": "#types" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#operators" }
      ]
    },
    "script-keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.keet",
          "match": "\\b(import|cpp|from|as)\\b"
        },
        {
          "name": "storage.type.state.keet",
          "match": "\\b(state|let)\\b"
        },
        {
          "name": "keyword.declaration.function.keet",
          "match": "\\b(def)\\b"
        },
        {
          "name": "keyword.control.keet",
          "match": "\\b(return|if|elif|else|for|in)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.primitive.keet",
          "match": "\\b(string|int|int64|double|float|bool|void)\\b"
        }
      ]
    },
    "template-section": {
      "begin": "(<)(template)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.template.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(template)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.template.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#template-control-flow" },
        { "include": "#interpolation" },
        { "include": "#template-tags" }
      ]
    },
    "template-control-flow": {
      "patterns": [
        {
          "match": "^\\s*(if|elif)\\s+(.*?)(:)",
          "captures": {
            "1": { "name": "keyword.control.conditional.keet" },
            "2": { "name": "source.keet.expression" },
            "3": { "name": "punctuation.separator.colon.keet" }
          }
        },
        {
          "match": "^\\s*(else)(:)",
          "captures": {
            "1": { "name": "keyword.control.conditional.keet" },
            "2": { "name": "punctuation.separator.colon.keet" }
          }
        },
        {
          "match": "^\\s*(for)\\s+([a-zA-Z0-9_]+)\\s+(in)\\s+(.*?)(:)",
          "captures": {
            "1": { "name": "keyword.control.loop.keet" },
            "2": { "name": "variable.parameter.loop.keet" },
            "3": { "name": "keyword.control.loop.in.keet" },
            "4": { "name": "source.keet.expression" },
            "5": { "name": "punctuation.separator.colon.keet" }
          }
        }
      ]
    },
    "interpolation": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.keet" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.keet" } },
      "name": "source.keet.interpolation",
      "patterns": [
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#operators" },
        {
          "name": "variable.other.readwrite.keet",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "template-tags": {
      "patterns": [
        {
          "begin": "(</?)([a-zA-Z0-9_\\-]+)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.html" }
          },
          "end": "(/?>)",
          "endCaptures": {
            "1": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#tag-attributes" }
          ]
        }
      ]
    },
    "tag-attributes": {
      "patterns": [
        {
          "match": "\\b(bind:(?:value|checked))(=)(\\{)([a-zA-Z0-9_]+)(\\})",
          "captures": {
            "1": { "name": "entity.other.attribute-name.directive.keet" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.section.embedded.begin.keet" },
            "4": { "name": "variable.other.state.keet" },
            "5": { "name": "punctuation.section.embedded.end.keet" }
          }
        },
        {
          "begin": "\\b(on[A-Z][a-zA-Z0-9_]*)(=)(\\{)",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.event.keet" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.section.embedded.begin.keet" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.keet" }
          },
          "patterns": [
            { "include": "#operators" },
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "variable.other.keet",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            }
          ]
        },
        {
          "match": "\\b([a-zA-Z0-9_\\-]+)(=)(\\{)(.*?)(\\})",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.section.embedded.begin.keet" },
            "4": { "name": "source.keet.expression" },
            "5": { "name": "punctuation.section.embedded.end.keet" }
          }
        },
        {
          "match": "\\b([a-zA-Z0-9_\\-]+)(=)(\"[^\"]*\"|'[^']*')",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "string.quoted.html" }
          }
        },
        {
          "name": "entity.other.attribute-name.boolean.html",
          "match": "\\b[a-zA-Z0-9_\\-]+\\b"
        }
      ]
    },
    "style-section": {
      "begin": "(<)(style)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "end": "(</)(style)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.style.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#style-rules" }
      ]
    },
    "style-rules": {
      "patterns": [
        {
          "begin": "([^{]+)(\\{)",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.class.css" },
            "2": { "name": "punctuation.section.property-list.begin.css" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.property-list.end.css" }
          },
          "patterns": [
            { "include": "#comments" },
            {
              "match": "([a-zA-Z0-9_\\-]+)\\s*(:)\\s*([^;]+)(;)",
              "captures": {
                "1": { "name": "support.type.property-name.css" },
                "2": { "name": "punctuation.separator.key-value.css" },
                "3": { "name": "support.constant.property-value.css" },
                "4": { "name": "punctuation.terminator.rule.css" }
              }
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.keet",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.keet", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.keet",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.keet", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.keet",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.keet",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.assignment.keet",
          "match": "\\+=|-=|="
        },
        {
          "name": "keyword.operator.comparison.keet",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.keet",
          "match": "\\+|-|\\*|/"
        }
      ]
    }
  }
}
